{
  "name": "fluentia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:fetch": "node scripts/fetch-content.mjs .content-cache",
    "content:build": "node scripts/build-content.mjs .content-cache public/packs/ja && npm run content:sentences && npm run content:grammar && npm run content:literature && npm run content:comics",
    "content:sentences": "node scripts/build-sentences.mjs .content-cache public/packs/ja",
    "content:grammar": "node scripts/build-grammar.mjs content/ja/grammar public/packs/ja",
    "icons": "pwa-assets-generator",
    "content:literature": "node scripts/build-literature.mjs content/ja/literature/works.json .content-cache content/ja/grammar public/packs/ja",
    "content:comics": "node scripts/build-comics.mjs .content-cache content/ja/grammar public/packs/ja"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fzstd": "^0.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "kuromoji": "^0.1.2",
    "seek-bzip": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
